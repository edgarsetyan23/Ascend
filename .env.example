# Copy this file to .env.local for local dev
# Production values are set in Vercel dashboard (never commit real values)

VITE_API_URL=https://<your-api-gateway-id>.execute-api.us-east-1.amazonaws.com
VITE_COGNITO_REGION=us-east-1
VITE_USER_POOL_ID=us-east-1_<your-pool-id>
VITE_USER_POOL_CLIENT_ID=<your-client-id>
VITE_GOOGLE_CLIENT_ID=<your-google-oauth-client-id>.apps.googleusercontent.com

# Server-only values for Vercel functions; never prefix these with VITE_.
# ANTHROPIC_API_KEY=
# Optional shared AI quotas across serverless instances:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
